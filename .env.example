# Admin portal login (required for /admin access)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=aura2026

# LLM for the admin assistant + public "Ask Aura" concierge.
# Default works with NO key, NO signup and NO credits (Puter.js):
VITE_LLM_PROVIDER=puter
VITE_LLM_MODEL=gpt-5.4-nano
VITE_LLM_API_KEY=

# Or switch provider (set VITE_LLM_PROVIDER accordingly, then restart npm run dev):
#   openai     → VITE_LLM_API_KEY=sk-...      (needs credits)
#   gemini     → VITE_LLM_API_KEY=AIza...     (free tier: aistudio.google.com/api-key)
#   groq       → VITE_LLM_API_KEY=gsk_...     (free tier: console.groq.com)
#   openrouter → VITE_LLM_API_KEY=sk-or-...   (free models available)
#VITE_LLM_PROVIDER=gemini
#VITE_LLM_MODEL=gemini-2.5-flash
#VITE_LLM_API_KEY=
